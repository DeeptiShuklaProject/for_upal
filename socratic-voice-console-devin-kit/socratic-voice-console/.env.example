# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Optional online or OpenAI-compatible answer provider.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45

# Optional ElevenLabs speech.
# ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=90
# ELEVENLABS_VOICE_MARGARET=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_CHRISTOPHER=VR6AewLTigWG4xSOukaG

# Optional local Voicebox (native REST API).
# Create/select voice profiles in Voicebox first. A generic profile ID can be
# overridden per persona. Inside Docker, use host.docker.internal rather than
# 127.0.0.1 when Voicebox runs on the host.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
# VOICEBOX_PROFILE_ID=
# VOICEBOX_PROFILE_MARGARET=
# VOICEBOX_PROFILE_CHRISTOPHER=
# VOICEBOX_ENGINE=kokoro
# VOICEBOX_MODEL_SIZE=0.6B
VOICEBOX_LANGUAGE=en
VOICEBOX_TIMEOUT_SECONDS=180

# Optional local VoiceStudio (OpenAI-compatible speech API).
# Voice values may be saved voice-profile IDs or names. Use the actual selected
# engine ID instead of tts-1 when your deployment requires explicit routing.
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900/v1
# VOICESTUDIO_API_KEY=
# VOICESTUDIO_PIN=
VOICESTUDIO_MODEL=tts-1
# VOICESTUDIO_VOICE=
# VOICESTUDIO_VOICE_MARGARET=
# VOICESTUDIO_VOICE_CHRISTOPHER=
VOICESTUDIO_TIMEOUT_SECONDS=180

# Optional custom corpus path.
# KNOWLEDGE_PATH=/absolute/path/to/knowledge.json
